@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<h1>You are authenticated</h1>

<AuthorizeView Roles="Admin">
    Hello @context.User.Identity?.Name. You can only read this since you're admin. 
</AuthorizeView>

<AuthorizeView>
    Hello @context.User.Identity?.Name. You can only read this since you're user.
</AuthorizeView>


